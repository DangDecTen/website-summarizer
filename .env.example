# Copy to .env and fill in the keys you actually use.
# LiteLLM reads these automatically. Leave unused providers blank.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama (default listen address)
OLLAMA_API_BASE=http://127.0.0.1:11434

# Shown first in the UI. Use LiteLLM model ids, e.g. openai/gpt-4o-mini
DEFAULT_MODEL=openai/gpt-4o-mini
OLLAMA_MODEL=ollama/llama3.2

# Comma-separated list for the model dropdown
AVAILABLE_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku-latest,gemini/gemini-2.0-flash,ollama/llama3.2

# Ingest limits
MAX_EXTRACT_CHARS=24000
FETCH_TIMEOUT_MS=30000
PLAYWRIGHT_BROWSER=firefox
